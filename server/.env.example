NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://YOUR_DATABASE_USER:YOUR_PASSWORD@YOUR_CLUSTER/YOUR_DATABASE
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_EXPIRES_IN=8h
ADMIN_EMAIL=YOUR_ADMIN_EMAIL
ADMIN_PASSWORD=SET_A_STRONG_UNIQUE_PASSWORD
# Optional: enables signed image uploads
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# Meta / Instagram Login API (configure after creating a Meta developer app)
META_APP_ID=YOUR_INSTAGRAM_APP_ID
META_APP_SECRET=YOUR_INSTAGRAM_APP_SECRET
META_REDIRECT_URI=https://YOUR-API-HOST/api/instagram/callback
META_GRAPH_VERSION=v26.0
# 32 random bytes encoded as 64 hexadecimal characters
TOKEN_ENCRYPTION_KEY=64_CHARACTER_HEX_KEY
